package main

import (
	services "changeme/internal/services"
	"embed"
	_ "embed"
	"log"
	"net/http"
	"os"
	"path/filepath"
	"strings"

	"github.com/wailsapp/wails/v3/pkg/application"
	"github.com/wailsapp/wails/v3/pkg/updater"
	"github.com/wailsapp/wails/v3/pkg/updater/providers/github"
)

// Wails uses Go's `embed` package to embed the frontend files into the binary.
// Any files in the frontend/dist folder will be embedded into the binary and
// made available to the frontend.
// See https://pkg.go.dev/embed for more information.

//go:embed all:frontend/dist
var assets embed.FS

//go:embed frontend/src/locales/*.json
var I18nFS embed.FS

const (
	currentVersion   = "1.0.0"
	githubRepository = "Github/RanPress"
)

// main function serves as the application's entry point. It initializes the application, creates a window,
// and starts a goroutine that emits a time-based event every second. It subsequently runs the application and
// logs any error that might occur.
func main() {
	appservice := &services.AppService{}
	// Initialize the database
	suidb, err := services.NewSuiStore()
	defer suidb.Close()
	if err != nil {
		// 处理错误，比如日志或退出
	}

	// Create a new Wails application by providing the necessary options.
	// Variables 'Name' and 'Description' are for application metadata.
	// 'Assets' configures the asset server with the 'FS' variable pointing to the frontend files.
	// 'Bind' is a list of Go struct instances. The frontend has access to the methods of these instances.
	// 'Mac' options tailor the application when running an macOS.
	app := application.New(application.Options{
		Name:        "RanPress",
		Description: "A demo of using raw HTML & CSS",
		Services: []application.Service{
			application.NewService(appservice),
			application.NewService(services.NewHotkeyService(suidb)),
			application.NewService(services.NewSystemInfo()),
			application.NewService(services.NewAppConfigService(suidb)),
			application.NewService(services.NewDocService(suidb)),
			application.NewService(&services.OCRService{}),
		},
		Assets: application.AssetOptions{
			Handler: application.AssetFileServerFS(assets),
			Middleware: uploadMiddleware(
				filepath.Join(
					os.Getenv("HOME"),
					"Library",
					"Application Support",
					"RanPress",
					"uploads",
				),
			),
		},
		Mac: application.MacOptions{
			ApplicationShouldTerminateAfterLastWindowClosed: true,
		},
	})

	githubToken := os.Getenv("GITHUB_TOKEN")
	// 初始化 GitHub 更新源
	gh, err := github.New(github.Config{
		Repository:    githubRepository,
		Token:         githubToken,
		ChecksumAsset: "SHA256SUMS",
	})
	if err != nil {
		log.Fatalf("initialize GitHub provider: %v", err)
	}

	// 初始化 Updater
	err = app.Updater.Init(updater.Config{
		CurrentVersion: currentVersion,
		Providers:      []updater.Provider{gh},
	})
	if err != nil {
		log.Fatalf("initialize updater: %v", err)
	}

	log.Printf("Updater initialized, current version: %s",
		app.Updater.CurrentVersion())

	appservice.SetApp(app, I18nFS, suidb)
	// Register hotkeys from the database and associate them with the second window.
	//services.LoadAndRegisterHotkeysFrom(suidb, services.HotkeyShowSecondWindow)

	// Create a goroutine that emits an event containing the current time every second.
	// The frontend can listen to this event and update the UI accordingly.
	// go func() {
	// 	 for {
	// 	 	now := time.Now().Format(time.RFC1123)
	// 	 	app.EmitEvent("time", now)
	// 	 	time.Sleep(time.Second)
	// 	 }
	// }()

	// Run the application. This blocks until the application has been exited.
	_err := app.Run()

	// If an error occurred while running the application, log it and exit.
	if _err != nil {
		log.Fatal(_err)
	}
}

func uploadMiddleware(uploadDir string) application.Middleware {
	return func(next http.Handler) http.Handler {
		return http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
			if !strings.HasPrefix(r.URL.Path, "/uploads/") {
				next.ServeHTTP(w, r)
				return
			}

			if r.Method != http.MethodGet && r.Method != http.MethodHead {
				http.Error(w, "Method Not Allowed", http.StatusMethodNotAllowed)
				return
			}

			filename := strings.TrimPrefix(r.URL.Path, "/uploads/")
			filename = filepath.Clean(filename)

			// 只允许访问上传目录中的文件
			if filename == "." || filepath.IsAbs(filename) ||
				filename == ".." || strings.HasPrefix(filename, ".."+string(filepath.Separator)) {
				http.Error(w, "Forbidden", http.StatusForbidden)
				return
			}

			filePath := filepath.Join(uploadDir, filename)

			http.ServeFile(w, r, filePath)
		})
	}
}
